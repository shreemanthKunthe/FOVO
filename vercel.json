{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/tmdb/:path*",
      "destination": "/api/tmdb?endpoint=:path*"
    },
    {
      "source": "/api/places/:path*",
      "destination": "/api/places?endpoint=:path*"
    }
  ]
}

